#!/bin/bash
# ~/.wakeup v4.9.15
CONF_FILE="$HOME/.sleepmanager.conf"
VERSION_FILE="$HOME/.sleepmanager_version"
LOG_FILE="$HOME/.sleeplog_history"
BATT_START_FILE="$HOME/.sleep_batt_start"
WAKE_INFO_FILE="$HOME/.wake_batt_info"
RESTORE_SCRIPT="$HOME/.sleepmanager_restore"
PMSET_SNAPSHOT_FILE="$HOME/.sleepmanager_pmset_snapshot"
DIAG_LOG_FILE="$HOME/.sleepmanager_diagnose"

[ -f "$CONF_FILE" ] && source "$CONF_FILE"
[ -f "$VERSION_FILE" ] && source "$VERSION_FILE"
PRESERVE_APP_SESSIONS=${PRESERVE_APP_SESSIONS:-true}
DISABLE_DARKWAKE_FEATURES=${DISABLE_DARKWAKE_FEATURES:-true}
LOG_ASSERTIONS=${LOG_ASSERTIONS:-true}
TOGGLE_BLUETOOTH_ON_SLEEP=${TOGGLE_BLUETOOTH_ON_SLEEP:-false}
AGGRESSIVE_POWER_PROFILE=${AGGRESSIVE_POWER_PROFILE:-false}

# Riattiva rete e scongela processi
sudo /usr/bin/pmset -a tcpkeepalive 1
sudo /usr/bin/pmset -a proximitywake 1

# Riavvia Dock per ripristinare funzionalità UI (Mission Control, full-screen)
killall Dock 2>/dev/null

restore_pmset_snapshot() {
    local key="$1"
    local snapshot_key="$2"
    local value=""
    if [ -f "$PMSET_SNAPSHOT_FILE" ]; then
        value=$(awk -v target="$key" -v alt="$snapshot_key" '
            {
                k = tolower($1)
                if (k == tolower(target) || k == tolower(alt)) {
                    print $2
                    exit
                }
            }
        ' "$PMSET_SNAPSHOT_FILE")
    fi
    [ -n "$value" ] && sudo /usr/bin/pmset -a "$key" "$value"
}

# Restore aggressive power settings
if [ "$AGGRESSIVE_POWER_PROFILE" = "true" ]; then
    sudo /usr/bin/pmset -a disksleep 1
    sudo /usr/bin/pmset -a autopoweroff 1
fi

if [ "$DISABLE_DARKWAKE_FEATURES" = "true" ]; then
    # Keep powernap off so wake does not re-open the same dark-wake loop.
    CURRENT_PN=$(/usr/bin/pmset -g custom | grep powernap | awk '{print $2}')
    [ "$CURRENT_PN" != "0" ] && sudo /usr/bin/pmset -a powernap 0
else
    restore_pmset_snapshot powernap powernap
    restore_pmset_snapshot womp womp
    restore_pmset_snapshot ttyskeepawake ttyskeepawake
    restore_pmset_snapshot sleepservices SleepServices
    restore_pmset_snapshot magicwake magicwake
fi
pkill -CONT -f "RTProtectionDaemon|Malwarebytes|virus|security"

# Registra dati per il prossimo log di uso attivo
BATT_WAKE=$(pmset -g batt | grep -o "[0-9]*%" | head -1)
echo "$(date +%s)|$BATT_WAKE" > "$WAKE_INFO_FILE"

# Calcolo Delta per la sessione di sonno appena conclusa
BATT_END=$BATT_WAKE
BATT_START=$(cat "$BATT_START_FILE" 2>/dev/null || echo "$BATT_END")
DELTA=$(( ${BATT_START%\%} - ${BATT_END%\%} ))
[ "$DELTA" -lt 0 ] && DELTA=0

echo "==== SESSION_START $(date '+%Y-%m-%d %H:%M:%S') ====" >> "$LOG_FILE"
echo "ACTION: WAKE | BATT: $BATT_END | DELTA: -$DELTA% (SLEEP LOSS)" >> "$LOG_FILE"

# Diagnostic snapshot after wake
if [ "$LOG_ASSERTIONS" = "true" ]; then
    {
        echo "==== DIAG_WAKE $(date '+%Y-%m-%d %H:%M:%S') ===="
        pmset -g assertions
        pmset -g log | tail -n 80
        echo "==== DIAG_END ===="
    } >> "$DIAG_LOG_FILE" 2>/dev/null

    pmset -g assertions | awk '/named:/{print}' | head -n 5 | while read -r line; do
        echo "  [ASSERTION] $line" >> "$LOG_FILE"
    done
fi

if [ "$TOGGLE_BLUETOOTH_ON_SLEEP" = "true" ]; then
    if command -v blueutil >/dev/null 2>&1; then
        blueutil -p 1
    fi
fi

# Ripristino Heavy Apps
APPS_KILLED="$HOME/.sleep_killed_apps"
if [ -f "$APPS_KILLED" ]; then
    pmset -g batt | grep -q "Battery Power" && IS_BATT=true || IS_BATT=false
    while read -r app; do
        [ -z "$app" ] && continue
        if [ "$IS_BATT" = true ] && [[ "$HEAVY_APPS" =~ "$app" ]]; then
            echo "  [POSTPONE] $app" >> "$LOG_FILE"
        else
            open -a "$app" && echo "  [RESTORE] $app" >> "$LOG_FILE"
        fi
    done < "$APPS_KILLED"
    rm "$APPS_KILLED"
fi

# Restore user apps and Terminal sessions
if [ -x "$RESTORE_SCRIPT" ]; then
    "$RESTORE_SCRIPT" --wake
fi
echo "==== SESSION_END ====" >> "$LOG_FILE"
