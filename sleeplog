#!/bin/bash
# ~/.sleeplog v4.9.15
LOG_FILE="$HOME/.sleeplog_history"
DIAG_LOG_FILE="$HOME/.sleepmanager_diagnose"
C_CYAN='\033[1;36m'; C_YELLOW='\033[1;33m'; C_GREEN='\033[0;32m'; C_RED='\033[0;31m'; C_GRAY='\033[0;90m'; NC='\033[0m'

format_output() {
    sed "s/ACTION: SLEEP/$(echo -e "${C_GRAY}💤 SLEEP${NC}")/g" | \
    sed "s/ACTION: WAKE/$(echo -e "${C_GREEN}☀️ WAKE${NC}")/g" | \
    sed "s/AWAKE: \([0-9]*\)m/$(echo -e "${C_CYAN}TEMPO ACCESO: \1 min${NC}")/g" | \
    sed "s/USED: -\([0-9]*\)%/$(echo -e "${C_YELLOW}USO: -\1%${NC}")/g" | \
    sed "s/DELTA: -0%/$(echo -e "${C_GREEN}DELTA SLEEP: 0% (PERFETTO)${NC}")/g" | \
    sed "s/DELTA: -[1-9]%/$(echo -e "${C_RED}&${NC}")/g" | \
    sed "s/\[KILL\]/$(echo -e "${C_RED}🔪 KILL${NC}")/g" | \
    sed "s/\[RESTORE\]/$(echo -e "${C_GREEN}↩︎ RESTORE${NC}")/g" | \
    sed "s/\[POSTPONE\]/$(echo -e "${C_YELLOW}⏸ POSTPONE${NC}")/g" | \
    sed "s/\[PRESERVE\]/$(echo -e "${C_GREEN}🛟 PRESERVE${NC}")/g"
}

usage() {
    cat <<'USAGE'
Uso:
  sleeplog                      Ultimi eventi (default)
  sleeplog last                 Ultima sessione completa
  sleeplog today|yesterday|week Eventi filtrati per data
  sleeplog stats [scope]        Statistiche aggregate
  sleeplog battery [scope]      Batteria sleep/wake per sessione
  sleeplog apps [scope]         App kill/restore per sessione
  sleeplog kills [scope]        Solo app killate (top)

Scope: last | today | yesterday | week (default: today)
USAGE
}

if [ ! -f "$LOG_FILE" ]; then
    echo -e "${C_RED}Nessun log disponibile: $LOG_FILE${NC}"
    exit 0
fi

show_assertion_alerts() {
    [ -f "$DIAG_LOG_FILE" ] || return 0
    alerts=$(grep -E "PreventUserIdleSystemSleep|NoDisplaySleepAssertion|ExternalMedia|MAGICWAKE" "$DIAG_LOG_FILE" | tail -n 8)
    [ -n "$alerts" ] || return 0
    echo -e "${C_RED}⚠️ ASSERTIONS BLOCCANTI${NC}"
    echo "$alerts" | sed "s/^/  - /"
    echo ""
}

build_date_set() {
    local days="$1"
    local i
    local out=""
    for ((i=0; i<days; i++)); do
        if [ "$i" -eq 0 ]; then
            out+="$(date +%Y-%m-%d) "
        else
            out+="$(date -v-${i}d +%Y-%m-%d) "
        fi
    done
    echo "$out"
}

filter_sessions_by_dates() {
    local date_set="$1"
    DATE_SET="$date_set" awk '
        BEGIN {
            n = split(ENVIRON["DATE_SET"], d, " ")
            for (i=1; i<=n; i++) if (d[i] != "") dates[d[i]] = 1
        }
        /^==== SESSION_START/ {
            in_session = 0
            for (day in dates) {
                if (index($0, day) > 0) { in_session = 1; break }
            }
        }
        { if (in_session) print }
    ' "$LOG_FILE"
}

last_session() {
    awk '
        /^==== SESSION_START/ { block = $0 "\n"; in_session = 1; next }
        { if (in_session) block = block $0 "\n" }
        /^==== SESSION_END/ { last = block; in_session = 0 }
        END { if (last != "") printf "%s", last }
    ' "$LOG_FILE"
}

battery_summary() {
    local input="$1"
    awk '
        function battery_value(value) {
            match(value, /[0-9]+%/)
            return substr(value, RSTART, RLENGTH - 1) + 0
        }
        /^==== SESSION_START/ { session = $0 }
        /ACTION: SLEEP/ {
            sleep_session = session
            sleep_batt = battery_value($0)
        }
        /ACTION: WAKE/ {
            wake_batt = battery_value($0)
            if (sleep_session != "") {
                delta = sleep_batt - wake_batt
                if (delta < 0) delta = 0
                printf "%s\nACTION: SLEEP | BATT: %d%%\nACTION: WAKE | BATT: %d%% | DELTA: -%d%%\n\n", sleep_session, sleep_batt, wake_batt, delta
                sleep_session = ""
            }
        }
    ' <<< "$input" | format_output
}

apps_summary() {
    awk '
        /\[KILL\]/ { line = $0; sub(/^.*\[KILL\] /, "", line); sub(/ \([^)]*\)$/, "", line); kills[line]++ }
        /\[RESTORE\]/ { line = $0; sub(/^.*\[RESTORE\] /, "", line); restores[line]++ }
        /\[POSTPONE\]/ { line = $0; sub(/^.*\[POSTPONE\] /, "", line); postponed[line]++ }
        /\[PRESERVE\]/ { preserved++ }
        END {
            for (app in kills) printf "[KILL] %s | COUNT: %d\n", app, kills[app]
            for (app in restores) printf "[RESTORE] %s | COUNT: %d\n", app, restores[app]
            for (app in postponed) printf "[POSTPONE] %s | COUNT: %d\n", app, postponed[app]
            if (preserved) printf "[PRESERVE] sessioni mantenute | COUNT: %d\n", preserved
        }
    ' | sort | format_output
}

kills_top() {
    awk '/\[KILL\]/ {
        line = $0
        sub(/^.*\[KILL\] /, "", line)
        sub(/ \([^)]*\)$/, "", line)
        print line
    }' | sort | uniq -c | sort -nr | awk '
        {
            count=$1; $1=""; sub(/^ /, ""); app=$0
            color="\033[0;90m"; reset="\033[0m"
            if (count >= 5) color="\033[0;31m"
            else if (count >= 2) color="\033[1;33m"
            printf "%s%2d %s%s\n", color, count, app, reset
        }
    '
}

scope_input() {
    local scope="$1"
    case "$scope" in
        last)
            last_session
            ;;
        today|"" )
            filter_sessions_by_dates "$(build_date_set 1)"
            ;;
        yesterday)
            filter_sessions_by_dates "$(date -v-1d +%Y-%m-%d)"
            ;;
        week)
            filter_sessions_by_dates "$(build_date_set 7)"
            ;;
        *)
            echo "Scope non valido: $scope" >&2
            exit 1
            ;;
    esac
}

case "$1" in
    help|-h|--help)
        usage
        ;;
    last)
        last_session | format_output
        ;;
    today|yesterday|week)
        scope_input "$1" | format_output
        ;;
    stats)
        show_assertion_alerts
        echo -e "${C_CYAN}📊 STATISTICHE VEGLIA/SONNO${NC}"
        if [ -n "$2" ]; then
            stats_input=$(scope_input "$2")
        else
            stats_input=$(cat "$LOG_FILE")
        fi
        awk '
            /ACTION: SLEEP/ && /AWAKE:/ {
                match($0, /AWAKE: [0-9]+m/); minutes += substr($0, RSTART + 7, RLENGTH - 8)
                match($0, /USED: -[0-9]+%/); value = substr($0, RSTART + 7, RLENGTH - 8) + 0
                if (value > 0) used += value
            }
            END { printf "Tempo totale acceso: %dm\nBatteria usata in veglia: %d%%\n", minutes, used }
        ' <<< "$stats_input"
        ;;
    battery)
        input=$(scope_input "${2:-today}")
        battery_summary "$input"
        ;;
    apps)
        input=$(scope_input "${2:-today}")
        apps_summary <<< "$input"
        ;;
    kills)
        input=$(scope_input "${2:-today}")
        kills_top <<< "$input"
        ;;
    *)
        show_assertion_alerts
        tail -n 50 "$LOG_FILE" | format_output
        ;;
esac
