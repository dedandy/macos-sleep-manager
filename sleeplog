#!/bin/bash
# ~/.sleeplog v4.7.4
LOG_FILE="$HOME/.sleeplog_history"
C_CYAN='\033[1;36m'; C_YELLOW='\033[1;33m'; C_GREEN='\033[0;32m'; C_RED='\033[0;31m'; C_GRAY='\033[0;90m'; NC='\033[0m'

format_output() {
    sed "s/ACTION: SLEEP/$(echo -e "${C_GRAY}💤 SLEEP${NC}")/g" | \
    sed "s/ACTION: WAKE/$(echo -e "${C_GREEN}☀️ WAKE${NC}")/g" | \
    sed "s/AWAKE: \([0-9]*\)m/$(echo -e "${C_CYAN}TEMPO ACCESO: \1 min${NC}")/g" | \
    sed "s/USED: -\([0-9]*\)%/$(echo -e "${C_YELLOW}USO: -\1%${NC}")/g" | \
    sed "s/DELTA: -0%/$(echo -e "${C_GREEN}DELTA SLEEP: 0% (PERFETTO)${NC}")/g" | \
    sed "s/DELTA: -[1-9]%/$(echo -e "${C_RED}&${NC}")/g" | \
    sed "s/\[KILL\]/$(echo -e "${C_RED}🔪 KILL${NC}")/g" | \
    sed "s/\[RESTORE\]/$(echo -e "${C_GREEN}↩︎ RESTORE${NC}")/g" | \
    sed "s/\[POSTPONE\]/$(echo -e "${C_YELLOW}⏸ POSTPONE${NC}")/g"
}

usage() {
    cat <<'USAGE'
Uso:
  sleeplog                      Ultimi eventi (default)
  sleeplog last                 Ultima sessione completa
  sleeplog today|yesterday|week Eventi filtrati per data
  sleeplog stats                Statistiche aggregate
  sleeplog battery [scope]      Batteria sleep/wake per sessione
  sleeplog apps [scope]         App kill/restore per sessione
  sleeplog kills [scope]        Solo app killate (top)

Scope: last | today | yesterday | week (default: today)
USAGE
}

if [ ! -f "$LOG_FILE" ]; then
    echo -e "${C_RED}Nessun log disponibile: $LOG_FILE${NC}"
    exit 0
fi

build_date_set() {
    local days="$1"
    local i
    local out=""
    for ((i=0; i<days; i++)); do
        if [ "$i" -eq 0 ]; then
            out+="$(date +%Y-%m-%d) "
        else
            out+="$(date -v-${i}d +%Y-%m-%d) "
        fi
    done
    echo "$out"
}

filter_sessions_by_dates() {
    local date_set="$1"
    DATE_SET="$date_set" awk '
        BEGIN {
            n = split(ENVIRON["DATE_SET"], d, " ")
            for (i=1; i<=n; i++) if (d[i] != "") dates[d[i]] = 1
        }
        /^==== SESSION_START/ {
            in_session = 0
            for (day in dates) {
                if (index($0, day) > 0) { in_session = 1; break }
            }
        }
        { if (in_session) print }
    ' "$LOG_FILE"
}

last_session() {
    awk '
        /^==== SESSION_START/ { block = $0 "\n"; in_session = 1; next }
        { if (in_session) block = block $0 "\n" }
        /^==== SESSION_END/ { last = block; in_session = 0 }
        END { if (last != "") printf "%s", last }
    ' "$LOG_FILE"
}

battery_summary() {
    local input="$1"
    awk '
        /^==== SESSION_START/ { session = $0; sleep_batt = ""; wake_batt = ""; delta = "" }
        /ACTION: SLEEP/ {
            match($0, /BATT: [0-9]+%/)
            sleep_batt = substr($0, RSTART + 6, RLENGTH - 6)
        }
        /ACTION: WAKE/ {
            match($0, /BATT: [0-9]+%/)
            wake_batt = substr($0, RSTART + 6, RLENGTH - 6)
            match($0, /DELTA: -[0-9]+%/)
            delta = substr($0, RSTART + 8, RLENGTH - 8)
        }
        /^==== SESSION_END/ {
            if (sleep_batt != "" || wake_batt != "") {
                printf "%s\nACTION: SLEEP | BATT: %s\nACTION: WAKE | BATT: %s | DELTA: -%s\n\n", session, sleep_batt, wake_batt, delta
            }
        }
    ' <<< "$input" | format_output
}

apps_summary() {
    awk '/\[KILL\]|\[RESTORE\]|\[POSTPONE\]/ {print}' | format_output
}

kills_top() {
    awk '/\[KILL\]/ {print $2}' | sort | uniq -c | sort -nr | awk '
        {
            count=$1; app=$2
            color="\033[0;90m"; reset="\033[0m"
            if (count >= 5) color="\033[0;31m"
            else if (count >= 2) color="\033[1;33m"
            printf "%s%2d %s%s\n", color, count, app, reset
        }
    '
}

scope_input() {
    local scope="$1"
    case "$scope" in
        last)
            last_session
            ;;
        today|"" )
            filter_sessions_by_dates "$(build_date_set 1)"
            ;;
        yesterday)
            filter_sessions_by_dates "$(build_date_set 2)" | awk 'BEGIN{d=strftime("%Y-%m-%d", systime()-86400)} /^==== SESSION_START/ {show=index($0,d)>0} {if (show) print}'
            ;;
        week)
            filter_sessions_by_dates "$(build_date_set 7)"
            ;;
        *)
            echo "Scope non valido: $scope" >&2
            exit 1
            ;;
    esac
}

case "$1" in
    help|-h|--help)
        usage
        ;;
    last)
        last_session | format_output
        ;;
    today|yesterday|week)
        scope_input "$1" | format_output
        ;;
    stats)
        echo -e "${C_CYAN}📊 STATISTICHE VEGLIA/SONNO${NC}"
        grep "AWAKE:" "$LOG_FILE" | awk -F'|' '{print $3, $4}' | sed 's/AWAKE: //; s/m //; s/USED: -//; s/%//' | \
        awk '{min+=$1; used+=$2} END {printf "Tempo totale acceso: %dm\nBatteria usata in veglia: %d%%\n", min, used}'
        ;;
    battery)
        input=$(scope_input "${2:-today}")
        battery_summary "$input"
        ;;
    apps)
        input=$(scope_input "${2:-today}")
        apps_summary <<< "$input"
        ;;
    kills)
        input=$(scope_input "${2:-today}")
        kills_top <<< "$input"
        ;;
    *)
        tail -n 50 "$LOG_FILE" | format_output
        ;;
esac
