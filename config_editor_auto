#!/bin/bash
# ~/.config_editor_auto v3.1 - multi-source add/reset for list variables

CONF_FILE="$HOME/.sleepmanager.conf"
LIST_TYPE="$1"
ACTION="${2:-add_file}"
LOG_FILE="$HOME/.sleepmanager_gui.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S'): $*" >> "$LOG_FILE"
}

notify() {
    local msg="$1"
    local sound="${2:-Glass}"
    osascript -e "display notification \"$msg\" with title \"Sleep Manager\" sound name \"$sound\"" >/dev/null 2>&1
}

compact_preview() {
    local raw="$1"
    local max_items="${2:-4}"
    local out=""
    local n=0
    local item=""
    local old_ifs="$IFS"
    IFS='|'
    for item in $raw; do
        [ -z "$item" ] && continue
        n=$((n + 1))
        if [ "$n" -le "$max_items" ]; then
            if [ -z "$out" ]; then
                out="$item"
            else
                out="$out, $item"
            fi
        fi
    done
    IFS="$old_ifs"
    if [ "$n" -gt "$max_items" ]; then
        out="$out, +$((n - max_items))"
    fi
    echo "$out"
}

normalize_list() {
    local raw="$1"
    awk -v input="$raw" 'BEGIN {
        n=split(input, a, "|")
        out=""
        for (i=1; i<=n; i++) {
            gsub(/^[ \t]+|[ \t]+$/, "", a[i])
            if (a[i] != "" && !(a[i] in seen)) {
                seen[a[i]] = 1
                out = (out == "" ? a[i] : out "|" a[i])
            }
        }
        print out
    }'
}

get_running_apps() {
    osascript <<'EOF_RUN'
set AppleScript's text item delimiters to "\n"
tell application "System Events"
    set appNames to name of every application process whose background only is false
end tell
return appNames as text
EOF_RUN
}

get_installed_apps() {
    find /Applications -maxdepth 2 -type d -name "*.app" -prune 2>/dev/null | \
        sed 's#.*/##; s/\.app$//' | \
        grep -v '^$' | \
        sort -fu
}

load_candidates() {
    # Bash 3.2 compatible array loading (no mapfile).
    local source="$1"
    CANDIDATES=()
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        CANDIDATES+=("$line")
    done <<< "$source"
}

choose_apps_from_lines() {
    local prompt="$1"
    shift

    if [ "$#" -eq 0 ]; then
        echo ""
        return 0
    fi

    osascript - "$prompt" "$@" <<'EOF_PICK'
on run argv
    if (count of argv) < 2 then return ""
    set promptText to item 1 of argv
    set appList to items 2 thru -1 of argv
    set selectedApps to choose from list appList with prompt promptText with multiple selections allowed without empty selection allowed
    if selectedApps is false then return ""
    set AppleScript's text item delimiters to "|"
    return selectedApps as text
end run
EOF_PICK
}

write_list_value() {
    local list_name="$1"
    local value="$2"
    local escaped="$value"
    escaped="${escaped//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"

    LIST_TYPE="$list_name" NEW_VAL="$escaped" perl -i.bak -pe '
        if (/^$ENV{LIST_TYPE}=/) {
            $_ = "$ENV{LIST_TYPE}=\"$ENV{NEW_VAL}\"\n";
        }
    ' "$CONF_FILE"
    rm -f "${CONF_FILE}.bak"
}

if [ -z "$LIST_TYPE" ]; then
    log "ERRORE - parametro lista mancante"
    notify "Errore: parametro lista mancante" "Basso"
    exit 1
fi

case "$LIST_TYPE" in
    WHITELIST|HEAVY_APPS|RESTORE_APPS|FORCE_SLEEP_KILL_APPS|QUICK_LAUNCH_APPS) ;;
    *)
        log "ERRORE - LIST_TYPE non valido: $LIST_TYPE"
        notify "Errore: lista non valida ($LIST_TYPE)" "Basso"
        exit 1
        ;;
esac

if [ ! -f "$CONF_FILE" ]; then
    log "ERRORE - Config non trovato"
    notify "File di configurazione mancante" "Basso"
    exit 1
fi

source "$CONF_FILE"
CURRENT_VAL="${!LIST_TYPE}"

log "Chiamato con LIST_TYPE=$LIST_TYPE ACTION=$ACTION"

case "$ACTION" in
    add_file|reset_file)
        load_candidates "$(get_installed_apps)"
        PROMPT="Seleziona una o più app da /Applications"
        ;;
    add_running|reset_running)
        load_candidates "$(get_running_apps | sed '/^$/d' | sort -fu)"
        PROMPT="Seleziona una o più app attualmente aperte"
        ;;
    reset_empty)
        CANDIDATES=()
        ;;
    *)
        log "ERRORE - ACTION non valida: $ACTION"
        notify "Errore: azione non valida ($ACTION)" "Basso"
        exit 1
        ;;
esac

if [ "$ACTION" = "reset_empty" ]; then
    write_list_value "$LIST_TYPE" ""
    log "Lista $LIST_TYPE svuotata"
    notify "$LIST_TYPE svuotata (0 app)"
    exit 0
fi

if [ "${#CANDIDATES[@]}" -eq 0 ]; then
    log "Nessuna app disponibile per ACTION=$ACTION LIST_TYPE=$LIST_TYPE"
    notify "Nessuna app disponibile ($ACTION)" "Basso"
    exit 0
fi

SELECTED_RAW="$(choose_apps_from_lines "$PROMPT" "${CANDIDATES[@]}")"
SELECTED="$(normalize_list "$SELECTED_RAW")"

if [ -z "$SELECTED" ]; then
    log "Selezione annullata"
    exit 0
fi

case "$ACTION" in
    add_*) NEW_VAL="$(normalize_list "$CURRENT_VAL|$SELECTED")" ;;
    reset_*) NEW_VAL="$SELECTED" ;;
esac

write_list_value "$LIST_TYPE" "$NEW_VAL"
log "Aggiornata $LIST_TYPE => $NEW_VAL"
SELECTED_COUNT="$(awk -F'|' '{print NF}' <<< "$SELECTED")"
SELECTED_PREVIEW="$(compact_preview "$SELECTED")"
case "$ACTION" in
    add_*)
        notify "$LIST_TYPE: aggiunte $SELECTED_COUNT app ($SELECTED_PREVIEW)"
        ;;
    reset_*)
        notify "$LIST_TYPE: reset a $SELECTED_COUNT app ($SELECTED_PREVIEW)"
        ;;
esac

exit 0
