#!/bin/bash
set -euo pipefail

if [ "${SKIP_VERSION_BUMP:-0}" = "1" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$REPO_ROOT" ] || exit 0

# Warn if the last commit did not touch the version file
if ! git diff --name-only HEAD~1..HEAD 2>/dev/null | grep -q "^version.sh$"; then
  echo "Pre-push: version.sh was not updated in the last commit." >&2
  echo "Run scripts/bump-version.sh or set SKIP_VERSION_BUMP=1 to bypass." >&2
  exit 1
fi
