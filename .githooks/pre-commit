#!/bin/bash
set -euo pipefail

if [ "${SKIP_VERSION_BUMP:-0}" = "1" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$REPO_ROOT" ] || exit 0

"$REPO_ROOT/scripts/bump-version.sh" patch

git add "$REPO_ROOT/version.sh" \
  "$REPO_ROOT/sleep" \
  "$REPO_ROOT/wakeup" \
  "$REPO_ROOT/sleeplog" \
  "$REPO_ROOT/install.sh" \
  "$REPO_ROOT/uninstall.sh" \
  "$REPO_ROOT/MASTER_INSTALL.sh" \
  "$REPO_ROOT/SleepManager.1m.sh" \
  "$REPO_ROOT/config_editor" \
  "$REPO_ROOT/config_editor_auto" \
  "$REPO_ROOT/config.template"
