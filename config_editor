#!/bin/bash
# ~/.sleepmanager_editor v4.7
CONF_FILE="$HOME/.sleepmanager.conf"
CYAN='\033[1;36m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; RED='\033[0;31m'; MAGENTA='\033[1;35m'; NC='\033[0m'

# Carica config
load_conf() { 
    if [ ! -f "$CONF_FILE" ]; then
        echo -e "${RED}Errore: $CONF_FILE non trovato!${NC}"
        exit 1
    fi
    source "$CONF_FILE"
}

# Salva valore nel config
save_val() { 
    local key="$1"
    local value="$2"
    local escaped="$value"
    escaped="${escaped//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    KEY="$key" VAL="$escaped" perl -i.bak -pe '
        if (/^$ENV{KEY}=/) {
            $_ = "$ENV{KEY}=\"$ENV{VAL}\"\n";
        }
    ' "$CONF_FILE" && rm -f "${CONF_FILE}.bak" && load_conf
}

count_list_items() {
    local value="$1"
    [ -z "$value" ] && echo 0 && return
    awk -F'|' '{print NF}' <<< "$value"
}

# Funzione per rimuovere app da una lista
remove_from_list() {
    local list_name=$1
    local current_list=$2
    
    if [ -z "$current_list" ]; then
        echo -e "${RED}Lista vuota!${NC}"
        read -p "Premi INVIO per continuare..."
        return
    fi
    
    clear
    echo -e "${CYAN}Rimuovi da $list_name${NC}\n"
    IFS='|' read -ra APPS <<< "$current_list"
    
    local i=1
    for app in "${APPS[@]}"; do
        [ -z "$app" ] && continue
        echo "$i) $app"
        ((i++))
    done
    echo "0) Annulla"
    
    read -p "> " choice
    if [ "$choice" -gt 0 ] && [ "$choice" -lt "$i" ]; then
        local app_to_remove="${APPS[$((choice-1))]}"
        local new_list=""
        local item=""
        for item in "${APPS[@]}"; do
            [ -z "$item" ] && continue
            [ "$item" = "$app_to_remove" ] && continue
            if [ -z "$new_list" ]; then
                new_list="$item"
            else
                new_list="$new_list|$item"
            fi
        done
        save_val "$list_name" "$new_list"
        echo -e "${GREEN}✓ $app_to_remove rimosso!${NC}"
        local updated_value="${!list_name}"
        echo ""
        if [ -z "$updated_value" ]; then
            echo -e "${YELLOW}Lista aggiornata: (vuota)${NC}"
        else
            echo -e "${CYAN}Lista aggiornata:${NC} $updated_value"
        fi
        read -p "Premi INVIO per continuare..."
    fi
}

# Gestione liste (Aggiungi/Rimuovi/Reset)
update_list() {
    while true; do
        clear
        echo -e "${CYAN}═══════════════════════════════════════${NC}"
        echo -e "${CYAN}Modifica Lista: $1${NC}"
        echo -e "${CYAN}═══════════════════════════════════════${NC}\n"
        
        # Mostra app attuali
        IFS='|' read -ra CURRENT_APPS <<< "$2"
        if [ -z "$2" ]; then
            echo -e "${YELLOW}Nessuna app configurata${NC}\n"
        else
            echo -e "${GREEN}App configurate:${NC}"
            for app in "${CURRENT_APPS[@]}"; do
                [ -z "$app" ] && continue
                echo "  • $app"
            done
            echo ""
        fi
        
        echo "1) Aggiungi app (manuale)"
        echo "2) Aggiungi app (da app aperte)"
        echo "3) Aggiungi app (da /Applications)"
        echo "4) Rimuovi app"
        echo "5) Reset da app aperte"
        echo "6) Reset da /Applications"
        echo "7) Svuota lista"
        echo "8) Indietro"
        echo ""
        read -p "> " choice
        
        case $choice in
            1)
                read -p "Nome app (es. Safari): " new_app
                [ -z "$new_app" ] && continue
                if [ -z "$2" ]; then
                    save_val "$1" "$new_app"
                else
                    NEW_VAL="$2|$new_app" && NEW_VAL="$(awk -v input="$NEW_VAL" 'BEGIN {
                        n=split(input, a, "|")
                        out=""
                        for (i=1; i<=n; i++) {
                            gsub(/^ [[:space:]]+|[[:space:]]+$/, "", a[i])
                            if (a[i] != "" && !(a[i] in seen)) {
                                seen[a[i]] = 1
                                out = (out == "" ? a[i] : out "|" a[i])
                            }
                        }
                        print out
                    }')"
                    save_val "$1" "$NEW_VAL"
                fi
                echo -e "${GREEN}✓ $new_app aggiunto!${NC}"
                read -p "Premi INVIO per continuare..."
                return
                ;;
            2)
                "$HOME/.config_editor_auto" "$1" add_running
                return
                ;;
            3)
                "$HOME/.config_editor_auto" "$1" add_file
                return
                ;;
            4)
                remove_from_list "$1" "$2"
                return
                ;;
            5)
                "$HOME/.config_editor_auto" "$1" reset_running
                return
                ;;
            6)
                "$HOME/.config_editor_auto" "$1" reset_file
                return
                ;;
            7)
                "$HOME/.config_editor_auto" "$1" reset_empty
                echo -e "${GREEN}✓ Lista svuotata!${NC}"
                read -p "Premi INVIO per continuare..."
                return
                ;;
            8)
                return
                ;;
        esac
    done
}

# Menu principale
while true; do
    load_conf
    clear
    echo -e "${CYAN}═══════════════════════════════════════${NC}"
    echo -e "${CYAN}  macOS SLEEP MANAGER EDITOR v4.9.22.21.20.19.18.17.16.15${NC}"
    echo -e "${CYAN}═══════════════════════════════════════${NC}\n"
    
    # Stato notifiche
    if [ "$ENABLE_NOTIFICATIONS" = "true" ]; then
        NOTIF_STATUS="${GREEN}✓ ON${NC}"
    else
        NOTIF_STATUS="${RED}✗ OFF${NC}"
    fi
    
    # Stato safe quit
    if [ "$SAFE_QUIT_MODE" = "true" ]; then
        SAFE_STATUS="${GREEN}✓ Sicura${NC}"
    else
        SAFE_STATUS="${YELLOW}⚡ Forzata${NC}"
    fi

    if [ "$PRESERVE_APP_SESSIONS" = "true" ]; then
        PRESERVE_STATUS="${GREEN}✓ ON${NC}"
    else
        PRESERVE_STATUS="${RED}✗ OFF${NC}"
    fi
    
    # Conta app nelle liste
    WHITELIST_COUNT=$(count_list_items "$WHITELIST")
    HEAVY_COUNT=$(count_list_items "$HEAVY_APPS")
    FORCE_COUNT=$(count_list_items "$FORCE_SLEEP_KILL_APPS")
    RESTORE_COUNT=$(count_list_items "$RESTORE_APPS")
    QUICK_COUNT=$(count_list_items "$QUICK_LAUNCH_APPS")
    
    echo -e "1) Notifiche:      $NOTIF_STATUS"
    echo -e "2) Chiusura:       $SAFE_STATUS"
    echo -e "3) Sessioni:       $PRESERVE_STATUS"
    echo -e "4) Soglia CPU:     ${YELLOW}$CPU_THRESHOLD%${NC}"
    echo -e "5) Whitelist:      ${GREEN}$WHITELIST_COUNT app${NC}"
    echo -e "6) Heavy Apps:     ${YELLOW}$HEAVY_COUNT app${NC}"
    echo -e "7) Force Kill:     ${RED}$FORCE_COUNT app${NC}"
    echo -e "8) Restore Apps:   ${CYAN}$RESTORE_COUNT app${NC}"
    echo -e "9) Quick Launch:   ${MAGENTA}$QUICK_COUNT app${NC}"
    echo ""
    echo -e "${CYAN}s)${NC} Salva ed Esci  ${CYAN}q)${NC} Annulla"
    echo ""
    read -p "> " opt
    
    case $opt in
        1) 
            [[ "$ENABLE_NOTIFICATIONS" == "true" ]] && save_val "ENABLE_NOTIFICATIONS" "false" || save_val "ENABLE_NOTIFICATIONS" "true"
            ;;
        2) 
            [[ "$SAFE_QUIT_MODE" == "true" ]] && save_val "SAFE_QUIT_MODE" "false" || save_val "SAFE_QUIT_MODE" "true"
            ;;
        3) 
            [[ "$PRESERVE_APP_SESSIONS" == "true" ]] && save_val "PRESERVE_APP_SESSIONS" "false" || save_val "PRESERVE_APP_SESSIONS" "true"
            ;;
        4) 
            read -p "Nuova soglia CPU (0.1-100.0): " new_cpu
            if [[ "$new_cpu" =~ ^[0-9]+\.?[0-9]*$ ]]; then
                save_val "CPU_THRESHOLD" "$new_cpu"
                echo -e "${GREEN}✓ Soglia aggiornata!${NC}"
            else
                echo -e "${RED}Valore non valido!${NC}"
            fi
            read -p "Premi INVIO per continuare..."
            ;;
        5) 
            update_list "WHITELIST" "$WHITELIST"
            ;;
        6) 
            update_list "HEAVY_APPS" "$HEAVY_APPS"
            ;;
        7)
            update_list "FORCE_SLEEP_KILL_APPS" "$FORCE_SLEEP_KILL_APPS"
            ;;
        8)
            update_list "RESTORE_APPS" "$RESTORE_APPS"
            ;;
        9)
            update_list "QUICK_LAUNCH_APPS" "$QUICK_LAUNCH_APPS"
            ;;
        s|S|q|Q) 
            echo -e "${GREEN}Configurazione salvata.${NC}"
            exit 0
            ;;
    esac
done
