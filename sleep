#!/bin/bash
# ~/.sleep v4.6
CONF_FILE="$HOME/.sleepmanager.conf"
VERSION_FILE="$HOME/.sleepmanager_version"
LOG_FILE="$HOME/.sleeplog_history"
WAKE_INFO_FILE="$HOME/.wake_batt_info"
TERMINAL_DIRS_FILE="$HOME/.sleepmanager_terminal_dirs"
PMSET_SNAPSHOT_FILE="$HOME/.sleepmanager_pmset_snapshot"
DIAG_LOG_FILE="$HOME/.sleepmanager_diagnose"
[ -f "$CONF_FILE" ] && source "$CONF_FILE"
[ -f "$VERSION_FILE" ] && source "$VERSION_FILE"

# 1. Analisi uso attivo (Dall'ultimo Wake)
BATT_SLEEP=$(pmset -g batt | grep -o "[0-9]*%" | head -1)
WAKE_INFO=$(cat "$WAKE_INFO_FILE" 2>/dev/null)
if [ -n "$WAKE_INFO" ]; then
    WAKE_TS=$(echo "$WAKE_INFO" | cut -d'|' -f1)
    WAKE_BATT=$(echo "$WAKE_INFO" | cut -d'|' -f2)
    NOW_TS=$(date +%s)
    DIFF_MIN=$(( (NOW_TS - WAKE_TS) / 60 ))
    USAGE=$(( ${WAKE_BATT%\%} - ${BATT_SLEEP%\%} ))
    
    echo "==== SESSION_START $(date '+%Y-%m-%d %H:%M:%S') ====" >> "$LOG_FILE"
    echo "ACTION: SLEEP | BATT: $BATT_SLEEP | AWAKE: ${DIFF_MIN}m | USED: -${USAGE}%" >> "$LOG_FILE"
else
    echo "==== SESSION_START $(date '+%Y-%m-%d %H:%M:%S') ====" >> "$LOG_FILE"
    echo "ACTION: SLEEP | BATT: $BATT_SLEEP" >> "$LOG_FILE"
fi

# Salva batteria per il prossimo Wake
echo "$BATT_SLEEP" > "$HOME/.sleep_batt_start"

# Capture Terminal working directories for restore
if pgrep -x "Terminal" >/dev/null 2>&1; then
    : > "$TERMINAL_DIRS_FILE"
    ttys=$(osascript -e 'tell application "Terminal" to get tty of every tab of every window' 2>/dev/null | tr -d '{}"' | tr ',' '\n' | tr -d ' ')
    while IFS= read -r tty; do
        [ -z "$tty" ] && continue
        pid=$(ps -t "$tty" -o pid= 2>/dev/null | awk 'NR==1{print $1}')
        [ -z "$pid" ] && continue
        cwd=$(lsof -a -d cwd -p "$pid" 2>/dev/null | awk 'NR==2 {print $NF}')
        [ -n "$cwd" ] && [ -d "$cwd" ] && echo "$cwd" >> "$TERMINAL_DIRS_FILE"
    done <<< "$ttys"
fi

# 2. Ottimizzazione Kernel
STANDBY_DELAY_MINUTES=${STANDBY_DELAY_MINUTES:-60}
DISABLE_DARKWAKE_FEATURES=${DISABLE_DARKWAKE_FEATURES:-true}
LOG_ASSERTIONS=${LOG_ASSERTIONS:-true}
STANDBY_DELAY_SECONDS=$((STANDBY_DELAY_MINUTES * 60))
sudo pmset -a tcpkeepalive 0 proximitywake 0 standby 1 standbydelayhigh "$STANDBY_DELAY_SECONDS" standbydelaylow "$STANDBY_DELAY_SECONDS"

# Snapshot and disable dark-wake related settings
pmset -g custom > "$PMSET_SNAPSHOT_FILE" 2>/dev/null
if [ "$DISABLE_DARKWAKE_FEATURES" = "true" ]; then
    sudo pmset -a powernap 0 womp 0 ttyskeepawake 0 sleepservices 0
fi

# Diagnostic snapshot for post-mortem
if [ "$LOG_ASSERTIONS" = "true" ]; then
    {
        echo "==== DIAG_SLEEP $(date '+%Y-%m-%d %H:%M:%S') ===="
        pmset -g assertions
        pmset -g log | tail -n 80
        echo "==== DIAG_END ===="
    } >> "$DIAG_LOG_FILE" 2>/dev/null

    pmset -g assertions | awk '/named:/{print}' | head -n 5 | while read -r line; do
        echo "  [ASSERTION] $line" >> "$LOG_FILE"
    done
fi
pkill -f "softwareupdated"

# 3. Gestione Processi
ps -u "$USER" -o %cpu,comm | sed '1d' | while read -r cpu comm; do
    app_name=$(basename -- "$comm")
    if echo "$app_name" | grep -qE "Finder|WindowServer|ControlCenter|Dock|WallpaperAgent|$WHITELIST"; then continue; fi
    if echo "$app_name" | grep -qE "RTProtectionDaemon|Malwarebytes|Logi|security"; then
        pkill -STOP -f "$app_name"
    elif (( $(echo "$cpu >= $CPU_THRESHOLD" | bc -l) )) || [[ "$HEAVY_APPS" =~ "$app_name" ]]; then
        echo "$app_name" >> "$HOME/.sleep_killed_apps"
        pkill -9 -f "$app_name"
        echo "  [KILL] $app_name ($cpu%)" >> "$LOG_FILE"
    fi
done
echo "==== SESSION_END ====" >> "$LOG_FILE"
